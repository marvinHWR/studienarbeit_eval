# Copy this file to `.env` and fill in real values. `.env` is gitignored — never commit it.
# litellm reads these environment variables automatically based on the model prefix:
#   generator "gemini/*"    -> GEMINI_API_KEY
#   judge     "anthropic/*" -> ANTHROPIC_API_KEY
GEMINI_API_KEY=your-google-ai-studio-key
ANTHROPIC_API_KEY=your-anthropic-key
